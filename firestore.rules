rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : null;
    }
    
    function getUserPharmacyId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pharmacyId 
        : null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'superadmin';
    }
    
    function isPharmacyMember(pharmacyId) {
      return isAuthenticated() && getUserPharmacyId() == pharmacyId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
    
    match /users/{userId} {
  allow read: if isSuperAdmin() ||
              request.auth.uid == userId ||
              (resource != null && isPharmacyMember(resource.data.pharmacyId));

  allow create: if
      // Self-signup: new admin creating their own profile
      (
        request.auth.uid == userId &&
        request.resource.data.role == 'admin' &&
        request.resource.data.status == 'pending'
      )
      ||
      // Admin/manager creating staff accounts for their own pharmacy
      (
        isAuthenticated() &&
        getUserRole() in ['admin', 'manager'] &&
        getUserPharmacyId() == request.resource.data.pharmacyId &&
        !(request.resource.data.role in ['admin', 'superadmin'])
      )
      ||
      // Superadmin creating pharmacy admins
      isSuperAdmin();

  allow update: if
      isSuperAdmin() ||
      (
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.pharmacyId == resource.data.pharmacyId
      ) ||
      (
        isPharmacyMember(request.resource.data.pharmacyId) &&
        getUserRole() in ['admin', 'manager'] &&
        !(request.resource.data.role in ['admin', 'superadmin']) &&
        !(resource.data.role in ['admin', 'superadmin'])
      );

  allow delete: if isSuperAdmin();
}
    
    match /pharmacies/{pharmacyId} {
      allow create: if
          isAuthenticated() &&
          request.resource.data.status == 'pending' &&
          request.resource.data.adminUid == request.auth.uid;
      
      // ✅ Added creator read access as safety net
      allow read: if isSuperAdmin() || 
                  isPharmacyMember(pharmacyId) ||
                  (resource != null && resource.data.adminUid == request.auth.uid);
      
      allow update, delete: if isSuperAdmin();
    }
    
    match /medicines/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
      allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
    }
    
    match /stockBatches/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
      allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
    }
    
    match /sales/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
      allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
    }
    
    match /suppliers/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
      allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
    }
    match /notifications/{docId} {
  allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
  allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
}
    
    match /stockMovements/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
      allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
    }
    
    match /settings/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(docId) || (resource != null && isPharmacyMember(resource.data.pharmacyId));
      allow write: if isSuperAdmin() || isPharmacyMember(docId) || isPharmacyMember(request.resource.data.pharmacyId);
    }
    
    match /counters/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(docId.split('_')[0]) || (resource != null && isPharmacyMember(resource.data.pharmacyId));
      allow write: if isSuperAdmin() || isPharmacyMember(docId.split('_')[0]) || isPharmacyMember(request.resource.data.pharmacyId);
    }

    match /pharmacyStats/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(docId);
      allow write: if isSuperAdmin() || isPharmacyMember(docId);
    }
    
    match /dailySalesStats/{docId} {
      allow read: if isSuperAdmin() || isPharmacyMember(resource.data.pharmacyId);
      allow write: if isSuperAdmin() || isPharmacyMember(request.resource.data.pharmacyId);
    }
  }
}
