# Firebase Configuration
# Priority 1: Use FIREBASE_SERVICE_ACCOUNT_JSON for full service account JSON
# Priority 2: Use direct Firebase vars from .env
# Priority 3: Use backend/serviceAccountKey.json when running locally

# Vercel/Production (full JSON string)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}

# Direct environment variables (works in .env)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Web Push VAPID Keys (generate using: npm run generate-vapid)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
